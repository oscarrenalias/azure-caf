#!/usr/bin/env bash
set -euo pipefail

echo "started $(date)" >> /tmp/runner.log

sudo apt install -y jq curl zip unzip

curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
sudo apt-get install -y nodejs
node --version

curl -fsSL 'https://azurecliprod.blob.core.windows.net/$root/deb_install.sh' | sudo bash

sudo -iu azureuser mkdir actions-runner
curl -o /home/azureuser/actions-runner/actions-runner-linux-x64-2.336.0.tar.gz -L https://github.com/actions/runner/releases/download/v2.336.0/actions-runner-linux-x64-2.336.0.tar.gz
tar xzf /home/azureuser/actions-runner/actions-runner-linux-x64-2.336.0.tar.gz -C /home/azureuser/actions-runner

sudo -iu azureuser /home/azureuser/actions-runner/config.sh --url https://github.com/tvdvoorde/caf \
            --token "${github_runner_pat}" \
            --url "https://github.com/${github_repository}" \
            --unattended \
            --replace 
sudo /home/azureuser/actions-runner/svc.sh install
sudo /home/azureuser/actions-runner/svc.sh stop
sudo /home/azureuser/actions-runner/svc.sh start

echo "finished $(date)" >> /tmp/runner.log
