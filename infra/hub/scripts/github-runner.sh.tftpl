#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/github-runner-bootstrap.log) 2>&1

runner_user="azureuser"
runner_home="/opt/actions-runner"
github_repository="${github_repository}"
github_runner_pat="${github_runner_pat}"

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --yes curl jq

runner_release="$$(curl --fail --silent --show-error \
  --header "Accept: application/vnd.github+json" \
  --header "X-GitHub-Api-Version: 2022-11-28" \
  https://api.github.com/repos/actions/runner/releases/latest)"
runner_version="$$(jq --exit-status --raw-output '.tag_name | ltrimstr("v")' <<<"$${runner_release}")"
runner_token="$$(curl --fail --silent --show-error --request POST \
  --header "Accept: application/vnd.github+json" \
  --header "Authorization: Bearer $${github_runner_pat}" \
  --header "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/repos/$${github_repository}/actions/runners/registration-token" \
  | jq --exit-status --raw-output '.token')"
unset github_runner_pat

mkdir --parents "$${runner_home}"
curl --fail --location --silent --show-error \
  --output /tmp/actions-runner.tar.gz \
  "https://github.com/actions/runner/releases/download/v$${runner_version}/actions-runner-linux-x64-$${runner_version}.tar.gz"
tar --extract --gzip --file /tmp/actions-runner.tar.gz --directory "$${runner_home}"
rm /tmp/actions-runner.tar.gz
chown --recursive "$${runner_user}:$${runner_user}" "$${runner_home}"
"$${runner_home}/bin/installdependencies.sh"

sudo --user "$${runner_user}" "$${runner_home}/config.sh" \
  --unattended \
  --replace \
  --url "https://github.com/$${github_repository}" \
  --token "$${runner_token}" \
  --name "$$(hostname)" \
  --labels "azure,hub" \
  --work "_work"
unset runner_token

"$${runner_home}/svc.sh" install "$${runner_user}"
"$${runner_home}/svc.sh" start