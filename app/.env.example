# Copy to .env and fill in values for local development.
# In hosted containers, FOUNDRY_PROJECT_ENDPOINT is auto-injected by the platform.

# Foundry project endpoint — copy from Terraform output: terraform -chdir=infra/lz01 output -raw foundry_project_endpoint
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name via the APIM connection registered on the Foundry Hub.
AZURE_AI_MODEL_DEPLOYMENT_NAME=apim-gateway/gpt-4o

# AI Search — copy from Terraform outputs: search_endpoint, search_primary_key
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=knowledge-base

# Port (default 8088 matches the Dockerfile EXPOSE and the Foundry hosting platform default)
PORT=8088
